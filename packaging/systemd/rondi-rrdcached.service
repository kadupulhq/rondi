[Unit]
Description=Rondi RRDtool-compatible cache daemon
After=local-fs.target

[Service]
Type=simple
User=rondi
Group=rondi
UMask=0007
StateDirectory=rondi rondi-journal
StateDirectoryMode=2770
RuntimeDirectory=rondi
RuntimeDirectoryMode=2770
# The journal holds trusted replay input; only the service account may
# read or replace it. StateDirectoryMode applies to both state directories.
ExecStartPre=/bin/chmod 0700 /var/lib/rondi-journal
ExecStart=/usr/bin/rrdcached -g -B -b /var/lib/rondi -j /var/lib/rondi-journal -m 0660 -s rondi -l unix:/run/rondi/rrdcached.sock
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rondi /var/lib/rondi-journal /run/rondi
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# Unix socket only. A TCP -l or -L needs AF_INET AF_INET6 here and
# PrivateNetwork removed.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=true
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
